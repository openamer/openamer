{
  "name": "openamer-vscode",
  "displayName": "OpenAmer Agent",
  "description": "OpenAmer AI Agent - background computer-use, swarm, tools",
  "version": "0.1.0",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages", "Chat", "Other"],
  "activationEvents": [
    "onCommand:openamer.chat",
    "onCommand:openamer.explain",
    "onCommand:openamer.fix",
    "onView:openamerChat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "openamer.chat", "title": "OpenAmer: Chat" },
      { "command": "openamer.explain", "title": "Ask OpenAmer to explain this" },
      { "command": "openamer.fix", "title": "Ask OpenAmer to fix this" }
    ],
    "menus": {
      "editor/context": [
        { "command": "openamer.fix", "when": "editorHasSelection", "group": "openamer@2" }
      ],
      "explorer/context": [
        { "command": "openamer.explain", "group": "openamer@1" }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "openamer", "title": "OpenAmer Agent", "icon": "$(comment-discussion)" }
      ]
    },
    "views": {
      "openamer": [
        { "type": "webview", "id": "openamerChat", "name": "Chat" }
      ]
    },
    "statusBar": [
      { "id": "openamer.status", "name": "OpenAmer Connection Status", "alignment": "right", "priority": 100 }
    ]
  },
  "scripts": {
      "compile": "tsc -p ./",
      "watch": "tsc -watch -p ./",
      "lint": "eslint src --ext ts",
      "check": "npm run compile"
    },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5"
  }
}